rules_version = '2';
// 홍콩반점 중앙대점 Firestore 보안 규칙 (Firebase 콘솔 → Firestore Database → 규칙 탭에 통째로 붙여 넣음)
// 원칙: 사장님은 전부, 매장계정·직원·투자자는 각자 화면에 필요한 문서만. 목록에 없는 문서는 사장님만.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── 도우미 ─────
    function signedIn() { return request.auth != null; }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(myPath()); }
    function me() { return get(myPath()).data; }
    function role() { return me().get('role', 'staff'); }
    function approved() { return !(me().get('status', 'approved') in ['pending', 'rejected']); }
    function isOwner() { return hasProfile() && role() == 'owner'; }
    function isStore() { return hasProfile() && role() == 'store' && approved(); }
    function isInvestor() { return hasProfile() && role() == 'investor' && approved(); }
    function isStaff() { return hasProfile() && role() == 'staff' && approved(); }
    function isMember() { return isOwner() || isStore() || isStaff(); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // 이번 저장으로 바뀌는 맨 위 칸들
    function changed() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyMyKey() { return changed().hasOnly([request.auth.uid]); }

    // 한국 시간 기준 이번 달('YYYY-MM')과 오늘('DD')
    function kst() { return request.time + duration.value(9, 'h'); }
    function two(n) { return n < 10 ? '0' + string(n) : string(n); }
    function thisMonth() { return string(kst().year()) + '-' + two(kst().month()); }
    function today() { return two(kst().day()); }

    // 입사 12개월 이상 직원 (지출입력 화면)
    function isLegend() {
      let j = me().get('joinDate', '');
      return j is string && j.matches('^[0-9]{4}-[0-9]{2}.*')
        && (kst().year() * 12 + kst().month()) - (int(j.split('-')[0]) * 12 + int(j.split('-')[1])) >= 12;
    }

    // ───── 사장님: 모든 문서 ─────
    match /{document=**} {
      allow read, write: if isOwner();
    }

    // ───── 사람 ─────
    match /users/{uid} {
      allow read: if isMe(uid) || isMember();
      // 회원가입: 내 문서를 '승인 대기 직원'으로만 만들 수 있음
      allow create: if isMe(uid)
        && request.resource.data.role == 'staff'
        && request.resource.data.status == 'pending';
      // 본인은 캐릭터·탭 순서·새로 열림 표시만 고칠 수 있음 (역할·시급·지급 아이템은 못 고침)
      allow update: if isMe(uid) && changed().hasOnly(['avatar', 'seenUnlocks', 'menuOrder']);
    }

    // 출퇴근: 다 같이 보고, 직원은 자기 칸만 씀. _config(위치·설정)은 사장님만 씀
    match /attendance/{ym} {
      allow read: if isMember();
      allow create, update: if isStaff() && ym != '_config' && onlyMyKey();
    }
    // 근무시간: 퇴근 찍을 때 폰이 자기 칸만 씀
    match /workhours/{ym} {
      allow read: if isMember();
      allow create, update: if isStaff() && onlyMyKey();
    }
    match /workextra/{ym} {
      allow read: if isMember();
      allow create, update: if isStaff() && onlyMyKey();
    }
    // 급여: 원본은 사장님만 읽음. 직원은 자기 칸의 '확인함'·'문의'만 씀 (읽지 않고)
    match /payroll/{ym} {
      allow update: if isStaff() && onlyMyKey()
        && request.resource.data[request.auth.uid]
             .diff(resource.data.get(request.auth.uid, {}))
             .affectedKeys().hasOnly(['checkedByEmp', 'checkedAt', 'inquiry']);
    }
    // 상여: 사장님만 (직원은 아래 payslips 복사본으로 자기 것만 봄)
    // 직원이 보는 내 급여·상여 복사본 (사장님이 급여를 저장할 때 만들어짐)
    match /payslips/{uid}/months/{ym} {
      allow read: if isMe(uid);
      allow update: if isMe(uid) && isStaff() && changed().hasOnly(['pay'])
        && request.resource.data.pay.diff(resource.data.pay).affectedKeys()
             .hasOnly(['checkedByEmp', 'checkedAt', 'inquiry']);
    }
    // 주민번호·계좌·전화번호·시급: 본인만 읽음, 쓰기는 사장님만
    match /userPrivate/{uid} {
      allow read: if isMe(uid);
    }
    match /schedule/{ym} {
      allow read: if isMember();
    }
    match /events/{ym} {
      allow read: if isMember();
    }

    // ───── 포상·포인트 ─────
    // rewards/points(설정)·shop(상점)·avatar(아바타 기준)·{YYYY-MM}(개근 포상)
    match /rewards/{id} {
      allow read: if isMember();
      // 상점: 직원은 맨 끝에 자기 '확인 대기' 신청 하나만 덧붙임
      allow update: if isStaff() && id == 'shop' && changed().hasOnly(['requests'])
        && request.resource.data.requests.size() == resource.data.get('requests', []).size() + 1
        && request.resource.data.requests[0:resource.data.get('requests', []).size()] == resource.data.get('requests', [])
        && request.resource.data.requests[resource.data.get('requests', []).size()].uid == request.auth.uid
        && request.resource.data.requests[resource.data.get('requests', []).size()].status == 'pending';
      // 개근 룰렛: 직원은 자기 결과만, 한 번만
      allow update: if isStaff() && id.matches('^[0-9]{4}-[0-9]{2}$') && changed().hasOnly(['spins'])
        && !(request.auth.uid in resource.data.get('spins', {}))
        && request.resource.data.spins.diff(resource.data.get('spins', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    // 개인 포인트·교환 코드: 본인만 읽음, 쓰기는 사장님만
    match /points/{uid} {
      allow read: if isMe(uid);
      match /codes/{reqId} {
        allow read: if isMe(uid);
      }
    }

    // ───── 매장 운영 (매장계정·직원) ─────
    match /checklist/{id} {
      allow read: if isMember();
      allow write: if isStore() || (isStaff() && id != 'holidays');
    }
    match /checklistPhotos/{id}  { allow read, write: if isMember(); }
    match /substitutes/{id}      { allow read, write: if isMember(); }
    match /notices/{id}          { allow read, write: if isMember(); }
    match /memos/{id}            { allow read, write: if isMember(); }
    match /cash/{ym}             { allow read, write: if isMember(); }
    match /cashSettings/{id}     { allow read: if isMember(); }
    match /lossClaims/{id}       { allow read, write: if isMember(); }
    match /lossClaimPhotos/{id}  { allow read, write: if isMember(); }
    match /prepaid/{id}          { allow read, write: if isStore(); }

    // 매출: 매장계정은 읽고 씀, 투자자는 읽기만 (직원은 못 봄)
    match /revenue/{id} {
      allow read: if isStore() || isInvestor();
      allow write: if isStore();
    }
    // 투자관리: 투자자는 읽기만
    match /investment/{id} {
      allow read: if isInvestor();
    }
    // 지출: 직원은 못 봄. 입사 12개월 이상 직원만 '오늘 칸'에 쓸 수 있음 (지출입력 화면)
    match /expenses/{ym} {
      allow create, update: if isStaff() && isLegend() && ym == thisMonth() && changed().hasOnly([today()]);
    }

    // ───── 손님용 (로그인 없이) ─────
    match /menu/{id} {
      allow read: if true;
      allow write: if isStore();
    }
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.phone is string;
      allow get: if true;
      allow list, update: if isStore();
    }
    // 폰 → 포스 사진·파일 전송 (폰은 로그인 없이 사진만 덧붙임)
    match /photoInbox/{sid} {
      allow create, read, delete: if isMember();
      allow update: if isMember()
        || ( request.time < resource.data.expiresAt
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['images'])
             && request.resource.data.images.size() <= 8 );
    }
  }
}
